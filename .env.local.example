# Proyecto Supabase de Tekly. URL y publishable key son públicas (van al
# bundle del cliente); sin ellas, las notificaciones caen a BroadcastChannel
# (cross-tab, mismo browser) en vez de Supabase Realtime (cross-device).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta. Solo se usa server-side (lib/auth, lib/db) para operaciones
# privilegiadas (alta de organización, invitar usuarios). NUNCA con prefijo
# NEXT_PUBLIC_ -- eso la mandaría al bundle del cliente. Sacarla de
# Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Origen público de la app -- base de los links que Supabase Auth manda por
# mail (confirmar cuenta, invitación, recuperar contraseña). Si falta, se
# deduce de los headers de la request; en producción conviene fijarla.
# Tiene que estar permitida en Supabase -> Authentication -> URL
# Configuration -> Redirect URLs (ej. http://localhost:3100/**).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Aviso de "Reportar un problema" (UserMenu) -- server-only. Bot creado con
# @BotFather; CHAT_ID es el chat/canal propio donde querés recibir los
# reportes (el bot tiene que ser miembro de ese chat). Sin estas dos, el
# reporte igual se guarda en `reportes_bugs`, solo no llega el aviso
# (ver lib/telegram.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
