# Proyecto Supabase de Tekly. URL y publishable key son públicas (van al
# bundle del cliente); sin ellas, las notificaciones caen a BroadcastChannel
# (cross-tab, mismo browser) en vez de Supabase Realtime (cross-device).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta. Solo se usa server-side (lib/auth, lib/db) para operaciones
# privilegiadas (alta de organización, invitar usuarios). NUNCA con prefijo
# NEXT_PUBLIC_ -- eso la mandaría al bundle del cliente. Sacarla de
# Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Emails (separados por comas) con acceso al panel de plataforma (/admin) --
# server-only, sin prefijo NEXT_PUBLIC_. El admin de plataforma es una
# allowlist a propósito (alcanza para 1-2 personas), no una columna en la
# base; sin esta variable /admin redirige a / para todos.
PLATFORM_ADMIN_EMAILS=

# Site key pública de Cloudflare Turnstile (challenges.cloudflare.com/turnstile)
# -- protege /signup contra bots/scripts rellenando el form (ver
# app/signup/signup-form.tsx). Sin esta variable el widget no se renderiza y
# el signup sigue funcionando igual, sin captcha. Para que efectivamente
# bloquee a los bots hace falta ADEMÁS activar "Bot and Abuse Protection" en
# Supabase Dashboard -> Authentication -> Settings con el secret key de
# Turnstile (ese secret vive en Supabase, no en esta app).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Origen público de la app -- base de los links que Supabase Auth manda por
# mail (confirmar cuenta, invitación, recuperar contraseña). Si falta, se
# deduce de los headers de la request; en producción conviene fijarla.
# Tiene que estar permitida en Supabase -> Authentication -> URL
# Configuration -> Redirect URLs (ej. http://localhost:3100/**).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Origen del sistema (la app de gestión) para los CTAs de la landing
# (app/marketing): "Ingresar" / "Probar gratis" apuntan acá. En producción el
# sistema vive en sistema.tekly.tech y la landing en tekly.tech -- dos
# dominios, un mismo deployment.
NEXT_PUBLIC_APP_URL=https://sistema.tekly.tech

# Aviso de "Reportar un problema" (UserMenu) -- server-only. Bot creado con
# @BotFather; CHAT_ID es el chat/canal propio donde querés recibir los
# reportes (el bot tiene que ser miembro de ese chat). Sin estas dos, el
# reporte igual se guarda en `reportes_bugs`, solo no llega el aviso
# (ver lib/telegram.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
